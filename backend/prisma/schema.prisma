generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ResumeVersion {
  id         String   @id @default(uuid())
  userId     String
  jobId      String
  content    String   @db.Text
  matchScore Int
  createdAt  DateTime @default(now())

  @@index([userId, jobId])
  @@index([createdAt])
}
